{
  "name": "@poa-box/browser",
  "version": "0.1.0",
  "description": "Framework-independent browser integration for Poa wallets, passkeys, durable operations and setup diagnostics.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "default": "./dist/wallet/index.js"
    },
    "./passkeys": {
      "types": "./dist/passkeys/index.d.ts",
      "default": "./dist/passkeys/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./observations": {
      "types": "./dist/observations/index.d.ts",
      "default": "./dist/observations/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "wallet": [
        "dist/wallet/index.d.ts"
      ],
      "passkeys": [
        "dist/passkeys/index.d.ts"
      ],
      "storage": [
        "dist/storage/index.d.ts"
      ],
      "session": [
        "dist/session/index.d.ts"
      ],
      "workflows": [
        "dist/workflows/index.d.ts"
      ],
      "config": [
        "dist/config/index.d.ts"
      ],
      "observations": [
        "dist/observations/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "api:check": "node scripts/check-api-surface.mjs",
    "api:update": "node scripts/check-api-surface.mjs --update",
    "prepublishOnly": "yarn build && yarn api:check"
  },
  "dependencies": {
    "@poa-box/core": "2.1.0"
  },
  "peerDependencies": {
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "ethers": "5.7.2",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poa-box/poa-cli.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  }
}
