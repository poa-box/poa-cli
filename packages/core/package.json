{
  "name": "@poa-box/core",
  "version": "2.2.0",
  "description": "Shared Poa protocol and integration toolkit for Node and browsers: reads, policies, transaction intents, optional wallet/passkey adapters, and durable workflows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/frontend-adoption.md",
    "docs/role-operations.md",
    "docs/agents.md",
    "docs/operation-manifest.v1.json",
    "docs/operation-manifest.schema.json",
    "docs/getting-started.md",
    "docs/workflow-recipes.v1.json",
    "docs/workflow-recipes.schema.json",
    "docs/browser.md",
    "docs/browser-integration.md",
    "docs/browser-features.v1.json",
    "docs/browser-features.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "default": "./dist/abis/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./graph/documents": {
      "types": "./dist/graph/documents/index.d.ts",
      "default": "./dist/graph/documents/index.js"
    },
    "./tx": {
      "types": "./dist/tx/index.d.ts",
      "default": "./dist/tx/index.js"
    },
    "./reads": {
      "types": "./dist/reads/index.d.ts",
      "default": "./dist/reads/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./execute": {
      "types": "./dist/execute/index.d.ts",
      "default": "./dist/execute/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./authority": {
      "types": "./dist/authority/index.d.ts",
      "default": "./dist/authority/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "default": "./dist/accounts/index.js"
    },
    "./sponsorship": {
      "types": "./dist/sponsorship/index.d.ts",
      "default": "./dist/sponsorship/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment/index.d.ts",
      "default": "./dist/deployment/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "default": "./dist/tasks/index.js"
    },
    "./treasury": {
      "types": "./dist/treasury/index.d.ts",
      "default": "./dist/treasury/index.js"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "default": "./dist/governance/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "default": "./dist/integrations/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/wallet": {
      "types": "./dist/browser/wallet/index.d.ts",
      "default": "./dist/browser/wallet/index.js"
    },
    "./browser/passkeys": {
      "types": "./dist/browser/passkeys/index.d.ts",
      "default": "./dist/browser/passkeys/index.js"
    },
    "./browser/storage": {
      "types": "./dist/browser/storage/index.d.ts",
      "default": "./dist/browser/storage/index.js"
    },
    "./browser/session": {
      "types": "./dist/browser/session/index.d.ts",
      "default": "./dist/browser/session/index.js"
    },
    "./browser/config": {
      "types": "./dist/browser/config/index.d.ts",
      "default": "./dist/browser/config/index.js"
    },
    "./browser/observations": {
      "types": "./dist/browser/observations/index.d.ts",
      "default": "./dist/browser/observations/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./browser/*": null,
    "./workflows/*": null
  },
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "abis": [
        "dist/abis/index.d.ts"
      ],
      "graph": [
        "dist/graph/index.d.ts"
      ],
      "graph/documents": [
        "dist/graph/documents/index.d.ts"
      ],
      "tx": [
        "dist/tx/index.d.ts"
      ],
      "reads": [
        "dist/reads/index.d.ts"
      ],
      "metadata": [
        "dist/metadata/index.d.ts"
      ],
      "execute": [
        "dist/execute/index.d.ts"
      ],
      "*": [
        "dist/*"
      ],
      "data": [
        "dist/data/index.d.ts"
      ],
      "authority": [
        "dist/authority/index.d.ts"
      ],
      "email": [
        "dist/email/index.d.ts"
      ],
      "accounts": [
        "dist/accounts/index.d.ts"
      ],
      "sponsorship": [
        "dist/sponsorship/index.d.ts"
      ],
      "deployment": [
        "dist/deployment/index.d.ts"
      ],
      "tasks": [
        "dist/tasks/index.d.ts"
      ],
      "treasury": [
        "dist/treasury/index.d.ts"
      ],
      "governance": [
        "dist/governance/index.d.ts"
      ],
      "integrations": [
        "dist/integrations/index.d.ts"
      ],
      "errors": [
        "dist/errors/index.d.ts"
      ],
      "browser": [
        "dist/browser/index.d.ts"
      ],
      "browser/wallet": [
        "dist/browser/wallet/index.d.ts"
      ],
      "browser/passkeys": [
        "dist/browser/passkeys/index.d.ts"
      ],
      "browser/storage": [
        "dist/browser/storage/index.d.ts"
      ],
      "browser/session": [
        "dist/browser/session/index.d.ts"
      ],
      "browser/config": [
        "dist/browser/config/index.d.ts"
      ],
      "browser/observations": [
        "dist/browser/observations/index.d.ts"
      ],
      "workflows": [
        "dist/workflows/index.d.ts"
      ],
      "browser/*": [
        "dist/__private_import_not_supported__"
      ],
      "workflows/*": [
        "dist/__private_import_not_supported__"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && node scripts/gen-abis.mjs && tsc",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/gen-abis.mjs && tsc --noEmit",
    "api:check": "node scripts/check-api-surface.mjs",
    "api:update": "node scripts/check-api-surface.mjs --update",
    "test:consumer": "node scripts/verify-packed-consumer.mjs",
    "test:browser-consumer": "node scripts/verify-browser-consumer.mjs"
  },
  "dependencies": {
    "@ethersproject/bytes": "^5.8.0",
    "@ethersproject/keccak256": "^5.8.0",
    "@ethersproject/strings": "^5.8.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "bs58": "^6.0.0",
    "poseidon-lite": "^0.3.0"
  },
  "peerDependencies": {
    "ethers": "^5.7.0",
    "permissionless": "^0.3.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "permissionless": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "ethers": "5.7.2",
    "permissionless": "^0.3.5",
    "typescript": "^5.6.0",
    "viem": "^2.47.12",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poa-box/poa-cli.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/poa-box/poa-cli",
  "bugs": {
    "url": "https://github.com/poa-box/poa-cli/issues"
  }
}
