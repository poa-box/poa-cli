      "states": [
        "ready",
        "blocked",
        "unknown"
      ],
      "sideEffects": {
        "indexedReads": true,
        "rpcReads": true,
        "fetchCurrentDocument": true,
        "publishes": false,
        "signs": false,
        "broadcasts": false,
        "persists": false
      },
      "retry": "Renew review on changed request/facts or reload; never upload."
    },
    {
      "id": "prepareRoleOperation",
      "import": "@poa-box/core/governance/role-operations",
