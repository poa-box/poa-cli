    "contracts.executor"
  ],
  "trust": [
    "Separate indexed/RPC endpoints and canonical source blocks; missing proof remains unknown.",
    "Review/prepared handles are immutable opaque memory authority, not JSON-replayable.",
    "Publisher receives exact reviewed UTF-8 json and keccak256 digest; valid CIDv0 is adapter attestation, not raw-JSON-to-IPFS integrity proof.",
    "Host owns scheduling, cancellation, consent, locks, versioned unsigned journals and wallet transport.",
    "Ready is current evidence, never authorization or executed outcome.",
    "Only readRoleOperationEvidence accepts purpose: operation (default) or capabilities. Capabilities derives available bound module reads even for blank forms, records its purpose and preserves absent/false/unknown facts; no subject prediction, holder grants, email registration or history. Review omits purpose and forces strict operation evidence at runtime; prepare/revalidate renew strict review and status independently proves exact outcomes."
  ],
  "operations": [
    {
      "id": "readRoleOperationEvidence",
      "import": "@poa-box/core/governance/role-operations",
      "async": true,
      "requiredInputs": [
        "scope",
        "request",
        "sources"
      ],
      "optionalInputs": [
        "purpose",
        "authoritySnapshot",
        "bounds",
        "signal"
      ],
      "ready": "RoleOperationEvidence",
      "states": [
        "ready",
        "blocked",
        "unknown"
      ],
      "sideEffects": {
        "indexedReads": true,
        "rpcReads": true,
        "fetchCurrentDocument": false,
        "publishes": false,
        "signs": false,
        "broadcasts": false,
        "persists": false
      },
      "retry": "Retry bounded reads with current scope; preserve unknown coverage. Capabilities readiness describes options only, never authorization or an executable review. Never sign, publish or send."
    },
    {
      "id": "reviewRoleOperation",
