        "fetchCurrentDocument": true,
        "publishes": true,
        "signs": false,
        "broadcasts": false,
        "persists": false
      },
      "retry": "Never automatically retry publication; retain successful/uncertain receipts and renew review."
    },
    {
      "id": "readRoleOperationStatus",
      "import": "@poa-box/core/governance/role-operations",
      "async": true,
      "requiredInputs": [
        "scope",
        "sources",
        "creation"
      ],
      "optionalInputs": [
        "configuration",
        "authoritySnapshot",
        "bounds",
        "signal",
        "fetchDocument"
      ],
      "ready": "RoleOperationStatus",
      "states": [
        "ready",
        "blocked",
        "unknown"
      ],
      "sideEffects": {
        "indexedReads": true,
        "rpcReads": true,
        "fetchCurrentDocument": true,
        "publishes": false,
        "signs": false,
        "broadcasts": false,
        "persists": false
      },
      "retry": "Recover missing transaction identity with the unsigned journal first; never send or history-scan. Retain the original review requiresConfiguration as host intent: exact created proof completes create-only work; review-configuration permits a separate requested stage, never an empty second vote. Configuration must use a different proven proposal and every call must bind to the actual created subject. Allowlist configuration requires at most one explicit root-verified document read; unsupported/unbound calls remain unknown with creation observations retained."
    },
    {
      "id": "revalidatePreparedRoleOperation",
      "import": "@poa-box/core/governance/role-operations",
      "async": true,
      "requiredInputs": [
        "scope",
        "sources",
        "review",
        "currentRequest",
        "prepared"
      ],
      "optionalInputs": [
        "fetchDocument",
        "publishDocument",
        "signal"
      ],
      "ready": "PreparedRoleOperation",
