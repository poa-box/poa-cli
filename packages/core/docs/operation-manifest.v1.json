        "ready",
        "blocked",
        "unknown"
      ],
      "sideEffects": {
        "indexedReads": true,
        "rpcReads": true,
        "fetchCurrentDocument": true,
        "publishes": false,
        "signs": false,
        "broadcasts": false,
        "persists": false
      },
      "retry": "Read again or renew review; never republish or silently change the batch."
    }
