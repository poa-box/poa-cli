  "module": "@poa-box/core/governance/role-operations",
  "units": {
    "subjectId": "uint256 decimal string; never Number or a name",
    "proposalId": "uint256 decimal string; exact reference",
    "projectId": "uint256 decimal string",
    "value": "native wei decimal string",
    "permissionKey": "bytes32",
    "ctx": "bytes32",
    "now": "integer Unix seconds",
    "createdAt": "integer Unix milliseconds",
    "durationMinutes": "integer minutes",
    "digest": "keccak256 of exact UTF-8 document json"
