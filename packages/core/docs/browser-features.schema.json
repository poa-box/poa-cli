{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poa.box/schemas/core/browser-features.v1.json",
  "title": "Poa core browser integration feature catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "package",
    "packageVersion",
    "releaseStatus",
    "authorization",
    "workflowStates",
    "retryPolicy",
    "units",
    "features"
  ],
  "properties": {
    "$schema": {
      "const": "./browser-features.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "const": "@poa-box/core"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseStatus": {
      "enum": [
        "candidate",
        "published"
      ]
    },
    "authorization": {
      "const": false
    },
    "workflowStates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ready",
          "blocked",
          "unknown",
          "pending",
          "confirmed"
        ]
      },
      "minItems": 5,
      "maxItems": 5
    },
    "retryPolicy": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "importPath",
          "export",
          "support",
          "requires",
          "sideEffects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "importPath": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^@poa-box/core/(?:browser/[a-z]+|workflows)$"
          },
          "export": {
            "type": [
              "string",
              "null"
            ]
          },
          "support": {
            "enum": [
              "supported",
              "supported-with-ports",
              "supported-atomic-only",
              "supported-read-only",
              "external-service",
              "unsupported"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sideEffects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "support": {
                  "enum": [
                    "external-service",
                    "unsupported"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "importPath": {
                  "type": "null"
                },
                "export": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "importPath": {
                  "type": "string"
                },
                "export": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
