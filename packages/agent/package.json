{
  "name": "@poa/agent",
  "version": "0.1.0",
  "description": "Autonomous governance agent runtime for the POP protocol — agent + brain (P2P CRDT) command surface over @poa/cli",
  "main": "dist/index.js",
  "bin": {
    "pop-agent": "./dist/pop-agent.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    ".env.agent.template",
    "README.md",
    "brain"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:xmachine-smoke": "yarn build && POP_BRAIN_HOME=${POP_BRAIN_HOME:-/tmp/brain-xmachine-loopback} POP_PRIVATE_KEY=${POP_PRIVATE_KEY:-$(grep -h '^POP_PRIVATE_KEY=' ~/.pop-agent/.env 2>/dev/null | head -1 | cut -d= -f2)} sh -c 'ROLE=publish node test/scripts/brain-cross-machine-smoke.js && ROLE=verify node test/scripts/brain-cross-machine-smoke.js'",
    "onboard": "bash scripts/onboard.sh",
    "apply": "bash scripts/apply.sh",
    "lint": "tsc --noEmit",
    "prepack": "npm pkg set 'dependencies.@poa/cli=^0.1.0'",
    "postpack": "npm pkg set 'dependencies.@poa/cli=link:../..'"
  },
  "dependencies": {
    "@poa/cli": "link:../..",
    "ethers": "5.7.2",
    "viem": "^2.47.12",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "@automerge/automerge": "^3.2.5",
    "@chainsafe/libp2p-gossipsub": "^14",
    "@chainsafe/libp2p-noise": "^16",
    "@chainsafe/libp2p-yamux": "^7",
    "@libp2p/autonat": "^2.0.38",
    "@libp2p/bootstrap": "^11.0.47",
    "@libp2p/circuit-relay-v2": "^3.2.24",
    "@libp2p/identify": "^3",
    "@libp2p/mdns": "^11",
    "@libp2p/tcp": "^10",
    "blockstore-fs": "^2",
    "datastore-fs": "^9",
    "helia": "^5.5.1",
    "libp2p": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/yargs": "^17.0.33",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
